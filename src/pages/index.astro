---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Showreel from '../components/Showreel.astro';
import Projects from '../components/Projects.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
---
<Base title="Nam Le — Gameplay & Systems Programmer" description="Nam Le: games design graduate and software developer in test moving into gameplay and systems programming. Projects, experience and CV.">
  <Header />
  <main id="main">
    <Hero />
    <Showreel />
    <Projects />
    <About />
    <Experience />
    <Contact />
  </main>
  <footer class="py-8 text-sm text-fg-3">
    <div class="container-page flex flex-wrap justify-between gap-x-4 gap-y-2">
      <span>Nam Le · London, UK</span>
      <a class="text-fg-2 hover:text-accent" href="https://github.com/Nam-L/portfolio" target="_blank" rel="noopener">Source on GitHub</a>
    </div>
  </footer>
</Base>
