---
import Section from './Section.astro';
import { about, skills } from '../data/site.js';
---
<Section id="about" alt class="grid gap-10 lg:grid-cols-[1.25fr_1fr] lg:gap-14">
  <div slot="head">
    <p class="kicker">About</p>
    <h2 class="mb-[clamp(1.25rem,3vw,2rem)] text-[clamp(1.75rem,4vw,2.4rem)]">Engineer first, gamer always</h2>
    <div class="grid gap-4 text-[1.05rem] text-fg-2">{about.map(p => <p>{p}</p>)}</div>
  </div>
  <div id="skills" class="card self-start">
    <h3 class="label">Skills</h3>
    <dl class="grid gap-2">
      {Object.entries(skills).map(([group, items]) => (
        <dt class="text-[0.95rem] font-semibold">{group}</dt>
        <dd class="mb-2.5"><ul class="flex flex-wrap gap-1.5">
          {items.map(s => <li class:list={['chip', s.includes('learning') && 'border-dashed border-accent-line bg-accent-soft text-accent']}>{s}</li>)}
        </ul></dd>
      ))}
    </dl>
  </div>
</Section>
