---
import { showreel } from '../data/site.js';
import { embedUrl } from '../lib/video.js';
const src = showreel && embedUrl(showreel);
---
{showreel && (
  <section id="showreel" class="pb-[clamp(3.5rem,8vw,6rem)]">
    <div class="container-page">
      <p class="kicker"><b>00</b>Showreel</p>
      <h2 class="mb-8 text-[clamp(1.75rem,4vw,2.4rem)]">Highlights</h2>
      <div class="aspect-video overflow-hidden rounded-lg border border-line bg-black shadow-lift">
        {src
          ? <iframe class="size-full" src={src} title="Showreel" loading="lazy" allowfullscreen allow="autoplay; encrypted-media; picture-in-picture"></iframe>
          : <video class="size-full" src={showreel} controls preload="metadata" playsinline></video>}
      </div>
    </div>
  </section>
)}
