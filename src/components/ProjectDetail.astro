---
import { render } from 'astro:content';
import { embedUrl } from '../lib/video.js';
const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const media = [...(p.video ? [{ video: p.video }] : []), ...p.images];
const facts = [['Role', p.role], ['Team', p.team], ['Engine', p.engine], ['Platform', p.platform]].filter(f => f[1]);
const links = [...(p.github ? [{ label: 'View on GitHub', url: p.github, primary: true }] : []), ...p.links];
---
<template data-project={project.id}>
  {media.length > 0 && (
    <div class="bg-black">
      {media.map((item, i) => (
        <div class="pd-slide aspect-video [&>*]:size-full [&>*]:border-0 [&>*]:object-contain" hidden={i > 0}>
          {item.video
            ? (embedUrl(item.video)
                ? <iframe src={embedUrl(item.video)} title={`${p.title} video`} loading="lazy" allowfullscreen allow="autoplay; encrypted-media; picture-in-picture"></iframe>
                : <video src={item.video} controls preload="metadata" playsinline></video>)
            : <img src={item.src} alt={item.alt} />}
        </div>
      ))}
      {media.length > 1 && (
        <div class="flex gap-2 overflow-x-auto bg-surface-2 px-4 py-2.5" role="group" aria-label="Media">
          {media.map((item, i) => (
            <button type="button" class="pd-thumb aspect-video w-22 shrink-0 cursor-pointer overflow-hidden rounded-md border-2 border-transparent bg-black text-white opacity-65 hover:opacity-100 aria-current:border-accent aria-current:opacity-100"
              aria-label={item.video ? 'Play video' : item.alt} aria-current={i === 0 ? 'true' : undefined}>
              {item.video ? <span aria-hidden="true">▶</span> : <img src={item.src} alt="" loading="lazy" class="size-full object-cover" />}
            </button>
          ))}
        </div>
      )}
    </div>
  )}
  <div class="px-[clamp(1.1rem,4vw,2rem)] pt-6 pb-8">
    <div class="mb-2.5 flex flex-wrap items-center gap-2.5">
      {p.year && <span class="font-mono text-xs text-fg-3">{p.year}</span>}
      {p.tags.map(t => <span class="tag">{t}</span>)}
    </div>
    <h2 id="pd-title" class:list={['mb-4 text-[clamp(1.4rem,3vw,1.75rem)]', !media.length && 'pr-11']}>{p.title}</h2>
    {facts.length > 0 && (
      <dl class="mb-5 grid grid-cols-[repeat(auto-fit,minmax(8.5rem,1fr))] gap-x-4 gap-y-3 rounded-lg border border-line bg-surface-2 px-4 py-3.5">
        {facts.map(([k, v]) => <div><dt class="font-mono text-[0.7rem] tracking-widest text-fg-3 uppercase">{k}</dt><dd class="font-medium">{v}</dd></div>)}
      </dl>
    )}
    {p.highlights.length > 0 && <><h3 class="label">What I built</h3><ul class="bullets mb-5">{p.highlights.map(h => <li>{h}</li>)}</ul></>}
    <div class="grid gap-3 text-fg-2"><Content /></div>
    {links.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-2.5">
        {links.map(l => <a href={l.url} target="_blank" rel="noopener" class:list={['btn', l.primary && 'btn-primary']}>{l.label}</a>)}
      </div>
    )}
  </div>
</template>
