---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { cv, email, github, linkedin, stats } from '../data/site.js';
const socials = [[github, 'github', 'GitHub'], [linkedin, 'linkedin', 'LinkedIn'], [`mailto:${email}`, 'mail', 'Email']];
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const spotlight = projects.find(p => p.data.featured) ?? projects[0];
const s = spotlight?.data;
---
<section id="top" class="relative isolate overflow-hidden pt-[clamp(3rem,9vw,6rem)] pb-[clamp(2.5rem,6vw,4rem)]">
  <div class="hero-grid-bg absolute inset-0 -z-10"></div>
  <div class="container-page grid items-center gap-10 lg:grid-cols-[1.25fr_1fr] lg:gap-14">
    <div>
      <p class="inline-flex items-center gap-2 rounded-md border border-line bg-surface py-1 pr-3 pl-2.5 font-mono text-xs text-fg-2">
        <span class="relative size-2 animate-blink rounded-full bg-live after:absolute after:inset-0 after:animate-ring after:rounded-full after:bg-live" aria-hidden="true"></span>
        Open to gameplay &amp; systems roles
      </p>
      <h1 class="mt-5 text-[clamp(2.75rem,9vw,5.25rem)] leading-none font-bold tracking-tighter">Nam Le</h1>
      <p class="mt-3 font-mono text-[clamp(0.9rem,2.2vw,1.05rem)] font-medium tracking-wide text-accent">Gameplay &amp; Systems Programmer</p>
      <p class="mt-4 max-w-xl text-[clamp(1.02rem,2vw,1.15rem)] text-fg-2">Games Design and Development graduate (First Class) with 6+ years of professional software engineering, now moving into the games industry.</p>
      <div class="mt-8 flex flex-wrap gap-3 max-[480px]:[&>*]:flex-1">
        <a class="btn btn-primary" href="#projects">View my work</a>
        <a class="btn" href={cv} download><Icon name="download" />Download CV</a>
      </div>
      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
        {socials.map(([href, icon, label]) => (
          <li><a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener" class="inline-flex items-center gap-2 font-medium text-fg-2 hover:text-accent"><Icon name={icon} />{label}</a></li>
        ))}
      </ul>
    </div>
    {s && (
      <a href={`#project/${spotlight.id}`} class="panel group block transition hover:border-accent-line hover:shadow-lift max-lg:hidden" aria-label={`Highlighted project: ${s.title}`}>
        <p class="panel-head">Highlighted project</p>
        <div class="viewport aspect-video overflow-hidden bg-surface-2">
          {(s.cover ?? s.images[0]?.src) && <img src={s.cover ?? s.images[0].src} alt="" class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />}
          {s.status && <span class="stamp absolute top-3.5 left-3.5">{s.status}</span>}
        </div>
        <div class="flex items-end justify-between gap-4 p-4">
          <div class="min-w-0">
            <p class="font-semibold">{s.title}</p>
            <p class="font-mono text-xs text-fg-3">{[s.engine, s.platform, s.year].filter(Boolean).join(' · ')}</p>
          </div>
          <span class="shrink-0 font-mono text-xs text-accent group-hover:underline">Breakdown →</span>
        </div>
      </a>
    )}
  </div>
  <div class="container-page mt-[clamp(2.5rem,6vw,4rem)]">
    <dl class="grid grid-cols-2 overflow-hidden rounded-lg border border-line bg-line gap-px lg:grid-cols-4">
      {stats.map(([value, label]) => (
        <div class="flex flex-col-reverse gap-1 bg-surface px-4 py-3.5"><dt class="text-sm text-fg-3">{label}</dt><dd class="font-mono text-[0.95rem] font-medium text-fg">{value}</dd></div>
      ))}
    </dl>
  </div>
</section>
